{
  "name": "docker-tracer",
  "version": "0.12.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server/index.mjs",
    "build": "vite build",
    "build:viewer": "vite build --config vite.viewer.config.js",
    "build:browser": "vite build --config vite.browser.config.js",
    "start": "node server/index.mjs --production",
    "test": "node --test tests/*.test.mjs",
    "test:docker": "node tests/docker.integration.mjs",
    "test:workspace:docker": "node tests/workspace.docker.integration.mjs",
    "test:lab:docker": "node tests/lab-editor.docker.integration.mjs",
    "test:lab:ui": "node tests/lab-ui.fixture.mjs",
    "test:ui:fixture": "node tests/ui.fixture.mjs",
    "format": "prettier --write src server shared tests package.json vite.config.js README.md",
    "test:projects:docker": "node tests/projects.docker.integration.mjs",
    "test:projects:ui": "node tests/projects-ui.fixture.mjs",
    "test:files:docker": "node tests/configuration.docker.integration.mjs",
    "test:startup:docker": "node tests/startup.docker.integration.mjs",
    "test:health:docker": "node tests/startup-health.docker.integration.mjs",
    "test:backups:docker": "node tests/backups.docker.integration.mjs",
    "test:compose:docker": "node tests/compose-api.docker.integration.mjs",
    "test:compose:transport": "node tests/compose-runner.docker.integration.mjs",
    "test:compose:ui": "node tests/compose-api.docker.integration.mjs --ui",
    "test:ui:light": "node tests/compose-api.docker.integration.mjs --ui --drafts-only",
    "test:catalog:docker": "node tests/catalog.docker.integration.mjs",
    "test:networks:docker": "node tests/compose-network.docker.integration.mjs",
    "test:ai:docker": "node tests/ai-infrastructure.docker.integration.mjs",
    "test:ai:database": "node tests/ai-external-db.docker.integration.mjs",
    "test:ai:hardware": "node tests/ai-hardware.docker.integration.mjs",
    "test:maintenance:ui": "node tests/maintenance-ui.fixture.mjs",
    "test:maintenance:docker": "node tests/maintenance-workbench.docker.integration.mjs",
    "test:maintenance:capture": "node tests/maintenance-capture.docker.integration.mjs",
    "test:redundancy:docker": "node tests/redundancy.docker.integration.mjs",
    "test:redundancy:api": "node tests/redundancy-api.docker.integration.mjs",
    "test:redundancy:ai-components": "node tests/ai-redundancy-components.docker.integration.mjs",
    "test:redundancy:ai-scale": "node tests/ai-redundancy-scale.docker.integration.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "@xyflow/react": "^12.10.0",
    "dockerode": "5.0.1",
    "express": "^5.1.0",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "ssh2": "^1.17.0",
    "tar-stream": "^2.2.0",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "prettier": "3.9.6",
    "vite": "^7.3.1"
  }
}
